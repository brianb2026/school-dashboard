# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Passwords are never stored here: you sign in to Blackboard/Google yourself,
# and OAuth tokens / session cookies go into the macOS Keychain, not this file.

# --- Server (local only: keep HOST on 127.0.0.1) ---
PORT=5179
HOST=127.0.0.1
# SQLite DB + cached course files
DATA_DIR=./data
# Copy from config/school.example.json
SCHOOL_CONFIG=./config/school.json

# --- Blackboard ---
BLACKBOARD_BASE_URL=https://yourschool.blackboard.com
# 1) Calendar feed (no admin needed): Blackboard > Calendar > settings > Share calendar > copy link.
#    Treat this link like a password; anyone with it can read your due dates.
BLACKBOARD_ICAL_URL=
# 2) Official REST API: only works if school IT registers the app's Application ID.
BLACKBOARD_APP_KEY=
BLACKBOARD_APP_SECRET=
BLACKBOARD_REDIRECT_URI=http://127.0.0.1:5179/auth/blackboard/callback
# 3) Session reader (opt-in): opens a browser window, you sign in yourself.
BLACKBOARD_SESSION_READER_ENABLED=false

# --- Gradescope (opt-in session reader; many courses also sync grades into Blackboard) ---
GRADESCOPE_SESSION_READER_ENABLED=false

# --- Gmail (your own Google Cloud project, OAuth client type "Desktop app") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5179/auth/google/callback

# --- Optional AI (off by default; all parsing works without it) ---
# none | anthropic | openai-compatible
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is much cheaper if you only use summaries
ANTHROPIC_MODEL=claude-opus-5-5
# Default points at a local Ollama server
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPAT_MODEL=llama3.1
OPENAI_COMPAT_API_KEY=
