# Optional. The dashboard works with no .env at all: you link Blackboard from the app.
# Copy to .env only if you need one of these. .env is git-ignored; never commit real values.
# Passwords are never stored anywhere. Saved sign-ins live encrypted in data/secrets.enc.

# --- Server (always local: any HOST other than 127.0.0.1/localhost is refused) ---
PORT=5179
HOST=127.0.0.1
# Database, encrypted sign-ins, cached course files, the sign-in browser's profile
DATA_DIR=./data
# Copy from config/school.example.json if you want to change GPA scale, time zone, letter cutoffs
SCHOOL_CONFIG=./config/school.json
# Path to Chrome/Edge/Brave if it isn't in the usual place
CHROME_PATH=

# --- Blackboard ---
# Normally typed once in the app ("Link Blackboard"). Setting it here pre-fills it.
BLACKBOARD_BASE_URL=
# Official REST API instead of the sign-in window: only if school IT registered an app for you.
BLACKBOARD_APP_KEY=
BLACKBOARD_APP_SECRET=
BLACKBOARD_REDIRECT_URI=http://127.0.0.1:5179/auth/blackboard/callback
# Calendar link fallback (due dates only). Easier to paste in Settings, where it is stored encrypted.
BLACKBOARD_ICAL_URL=

# --- Gmail (optional; your own Google Cloud project, OAuth client type "Desktop app") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5179/auth/google/callback

# --- Optional AI (off by default; nothing is sent anywhere unless you turn this on and click Summarize) ---
# none | anthropic | openai-compatible
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is much cheaper if you only use summaries
ANTHROPIC_MODEL=claude-opus-5-5
# Default points at a local Ollama server
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPAT_MODEL=llama3.1
OPENAI_COMPAT_API_KEY=

# --- Troubleshooting ---
# Print each request (paths only, never query strings)
LOG_REQUESTS=0
